# Existing optional scaffold database: the Git CMS does not use it.
DATABASE_URL=""

# Server-only GitHub sign-in; reuse an approved OAuth application.
# Callback: <AUTH_URL>/api/auth/callback/github
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
ADMIN_GITHUB_IDS=""
# Artist sign-in with verified Google email; identity scopes only.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ADMIN_EMAILS="waambat@gmail.com"
# Backup login is disabled until an approved database/account is explicitly provisioned.
# Apply both admin-account and shared password-admission migrations before enabling.
AUTH_DATABASE_URL=""
# Set netlify only after approving and configuring this project’s Netlify Database.
# SDK selects the current deploy database branch; never share a production URL with previews.
ADMIN_DATABASE_PROVIDER="external"
ADMIN_PASSWORD_LOGIN="0"

# Outbound email uses separate credentials/grants; never request sending scopes for sign-in.
# List a sender here only after actual mailbox/provider verification.
EMAIL_VERIFIED_SENDERS=""
GMAIL_USER=""
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Approved GitHub App installed only on Ravonus/waambat.com.
# Permissions: Contents read/write, Metadata read. No workflows/admin permission.
GITHUB_APP_ID=""
GITHUB_APP_INSTALLATION_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_CONTENT_BRANCH="feat/gallery-admin-modernization"
GITHUB_DRAFT_BRANCH="cms/waambat-review-drafts"

# Uploads are disabled by default. Large videos remain on the approved existing host.
# Enable only after approval of storage/cost and validation on the selected Netlify site.
NETLIFY_MEDIA_ENABLED="0"
# Public portfolio; /admin, draft previews and unpublished uploads always require authorization.
# Set 1 only for an explicitly requested private whole-site review.
WAAMBAT_PRIVATE_SITE="0"

# Original Adobe loader, gated to the existing licensed production hostname only.
# Preview hosts keep fallback fonts; confirm license/domain setup before enabling.
WAAMBAT_ORIGINAL_FONTS="0"

# Owner-approved Adobe web-project domains, only after adding them to the licensed kit.
WAAMBAT_FONT_HOSTS=""
# Set Netlify test target flags in the UI for Functions/runtime as documented.
ADMIN_TEST_LOGIN="0"
CMS_CONTENT_PROVIDER="git"
