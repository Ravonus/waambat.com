+   {id:'mosaic',kind:'stage',startBeat:8,beats:4,transition:{type:'mosaic',beats:1,blockSize:32},layers:[{source:'b',fit:'cover'},{source:'m',blend:'difference',opacity:.5,loop:true}]},
