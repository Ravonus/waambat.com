{
  "name": "waambat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm content:check && next build",
    "check": "pnpm lint && pnpm typecheck",
    "db:generate": "drizzle-kit generate",
