    "@vimeo/player": "^2.30.4",
    "drizzle-orm": "^0.45.4",
    "hls.js": "1.6.15",
    "next": "^16.4.0",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.0.16",
    "postgres": "^3.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.23.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/youtube": "^0.3.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "playwright": "^1.64.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.5.3"
